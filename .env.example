# Copy to .env and fill in. .env stays out of git, it holds the keys.

###############################################################################
# Web server (Caddy / FrankenPHP)
###############################################################################
# The name the portal answers to; Caddy gets its certificate itself
SERVER_NAME=portal.example.net

# Behind a proxy that routes TLS by SNI and sends the PROXY protocol (e.g. HAProxy send-proxy-v2):
# LISTENER_MODE=behind-proxy and the proxy's network, where the PROXY header is trusted from.
# The CRM counts failed sign-ins by the customer's address, so it has to be the real one.
# Without a proxy only this machine is trusted.
#LISTENER_MODE=direct
#PROXY_ALLOW=192.168.1.0/24 fd0e:b807:26ee:1::/64

# Language and formats of the pages, as in Watcher CRM: en_US (the texts in the code), cs_CZ, hr_HR,
# or any locale with a catalogue in resources/locales
#APP_DEFAULT_LOCALE=en_US
# The currency of the invoices (ISO 4217)
#CURRENCY=EUR
# Dates and times the portal shows and writes
#TIMEZONE=Europe/Prague
# A customer is signed out after this many minutes without a request
#SESSION_IDLE_MINUTES=30

# Where the operator's profile is: $DATA_DIR/profile (see README), without it profiles/default
#DATA_DIR=./data

###############################################################################
# Operator
###############################################################################
OPERATOR_NAME=Example ISP, s.r.o.
# Linked from the footer
#OPERATOR_WEBSITE=https://www.example.net
# Linked from the consents of the default profile
#PRIVACY_POLICY_URL=https://www.example.net/privacy

###############################################################################
# Watcher CRM, where the customers, their passwords and invoices are
###############################################################################
# The customer portal API of the CRM
CRM_API_URL=https://crm.example.net/api/customer-portal
# API key of a CRM user of its own with the customer-portal role
CRM_API_KEY=
# Only against a development CRM with a certificate of its own
#CRM_API_VERIFY_TLS=false

###############################################################################
# Mail with the changes a customer asks for on the customer data page
###############################################################################
SMTP_HOST=mail.example.net
#SMTP_PORT=587
# tls (STARTTLS), ssl, or none
#SMTP_SECURE=tls
# Leave the user empty when the server takes mail without signing in
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=portal@example.net
# Defaults to the page name of the profile
#MAIL_FROM_NAME=
# Who receives the requests; several addresses separated by commas
CHANGE_REQUESTS_TO=contracts@example.net
