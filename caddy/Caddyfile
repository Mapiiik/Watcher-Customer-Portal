# FrankenPHP, set up like all our Caddy servers: the PROXY protocol is always on, LISTENER_MODE
# picks how Caddy faces the world (see modes/). Based on the default Caddyfile of FrankenPHP.
{
	skip_install_trust
	import modes/{$LISTENER_MODE:direct}/global.caddy

	# The PROXY protocol header is used when it comes from PROXY_ALLOW (by default this machine only)
	# and is optional there, from anywhere else it is ignored. So it stays on, with or without a proxy
	# in front, and nobody else can claim an address.
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {$PROXY_ALLOW:127.0.0.1/32 ::1/128}
			}
			tls
		}
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	encode zstd br gzip

	# The portal loads nothing from elsewhere and is framed only by itself; a page may set its own
	header {
		?Strict-Transport-Security "max-age=31536000"
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
		?X-Frame-Options "SAMEORIGIN"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "same-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}

import Caddyfile.d/*.caddyfile
